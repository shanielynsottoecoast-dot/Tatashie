<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>MACDKEN | Good Food. Good Vibes. Good Mood.</title>


    <style>

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #fff8ed;
            color: #292929;
            line-height: 1.6;
        }

        header {
            background: #b90f2f;
            color: white;
            padding: 22px 7%;
            border-bottom: 5px solid #f5c542;
        }

        .header-inner {
            max-width: 1200px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .logo-area h1 {
            margin: 0;
            font-size: 34px;
            letter-spacing: 3px;
        }

        .logo-area p {
            margin: 2px 0 0;
            font-size: 13px;
            letter-spacing: 1px;
        }

        .tagline-extra {
            font-size: 12px;
            margin-top: 3px;
            color: #ffe9a8;
            font-weight: bold;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
        }

        nav a {
            color: white;
            text-decoration: none;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 4px;
        }

        nav a:hover {
            background: white;
            color: #b90f2f;
        }


        /* HERO */

        .hero {
            background:
                linear-gradient(
                    rgba(255, 232, 182, 0.92),
                    rgba(255, 248, 237, 0.95)
                );

            padding: 70px 7%;
        }

        .hero-inner {
            max-width: 1200px;
            margin: auto;

            display: grid;
            grid-template-columns: 1fr 1fr;

            align-items: center;
            gap: 45px;
        }

        .hero-text h2 {
            margin: 0;
            color: #b90f2f;
            font-size: 52px;
            line-height: 1.05;
        }

        .hero-text h3 {
            font-size: 28px;
            margin: 12px 0;
        }

        .hero-tagline {
            font-size: 18px;
            font-weight: bold;
            color: #555;
        }

        .hero-number {
            display: inline-block;
            margin-top: 5px;
            font-size: 16px;
            color: #b90f2f;
            font-weight: bold;
        }

        .hero-text p {
            max-width: 560px;
            color: #555;
            font-size: 17px;
        }

        .hero-image img {
            width: 100%;
            height: 430px;
            object-fit: cover;
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.18);
        }

        .button {
            display: inline-block;
            background: #b90f2f;
            color: white;
            padding: 13px 25px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 5px;
            margin-top: 12px;
        }

        .button:hover {
            background: #8e0923;
        }


        /* GENERAL SECTIONS */

        .section {
            padding: 65px 7%;
        }

        .section-inner {
            max-width: 1200px;
            margin: auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 35px;
        }

        .section-title h2 {
            margin-bottom: 5px;
            color: #b90f2f;
            font-size: 34px;
        }

        .section-title p {
            color: #666;
        }


        /* WHY MACDKEN */

        .why-grid {
            display: grid;
            grid-template-columns:
                repeat(4, 1fr);
            gap: 18px;
        }

        .why-box {
            background: white;
            border: 1px solid #e3d9ca;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        .why-box summary {
            color: #b90f2f;
            font-weight: bold;
            font-size: 20px;
            cursor: pointer;
        }

        .why-box p {
            color: #555;
        }


        /* CATEGORIES */

        .category-grid {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 25px;
        }

        .category {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #e3d9ca;
            box-shadow: 0 7px 18px rgba(0,0,0,0.08);
        }

        .category > img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .category-content {
            padding: 20px;
        }

        .category-content h3 {
            color: #b90f2f;
            margin-top: 0;
            font-size: 25px;
        }

        .category-content p {
            color: #555;
        }

        details {
            margin-top: 15px;
        }

        summary {
            cursor: pointer;
        }

        .category summary {
            background: #b90f2f;
            color: white;
            padding: 11px 15px;
            border-radius: 4px;
            font-weight: bold;
        }

        .category summary:hover {
            background: #8e0923;
        }

        .food-list {
            margin-top: 15px;
        }

        .food-item {
            border-bottom: 1px solid #ddd;
            padding: 15px 0;

            display: flex;
            justify-content: space-between;
            gap: 15px;
        }

        .food-item:last-child {
            border-bottom: none;
        }

        .food-item h4 {
            margin: 0;
            color: #333;
        }

        .food-item p {
            font-size: 14px;
            margin: 5px 0 8px;
        }

        .food-price {
            color: #b90f2f;
            font-weight: bold;
            white-space: nowrap;
        }

        .small-button {
            display: inline-block;
            background: #b90f2f;
            color: white;
            padding: 7px 11px;
            text-decoration: none;
            font-size: 12px;
            border-radius: 3px;
        }

        .small-button:hover {
            background: #8e0923;
        }


        /* BEST SELLERS */

        .best-grid {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 25px;
        }

        .best-card {
            background: white;
            border: 1px solid #e3d9ca;
            border-radius: 10px;
            overflow: hidden;
        }

        .best-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .best-content {
            padding: 20px;
        }

        .best-content h3 {
            margin-top: 0;
            color: #b90f2f;
        }

        .price {
            font-size: 20px;
            font-weight: bold;
            color: #b90f2f;
        }


        /* PROMOS */

        .promo-grid {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 20px;
        }

        .promo {
            background: #fff;
            border-left: 6px solid #b90f2f;
            padding: 25px;
            border-radius: 7px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.06);
        }

        .promo h3 {
            color: #b90f2f;
            margin-top: 0;
        }


        /* MENU TABLE */

        .table-wrapper {
            overflow-x: auto;
            background: white;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 700px;
        }

        th {
            background: #b90f2f;
            color: white;
            padding: 15px;
            text-align: left;
        }

        td {
            padding: 13px 15px;
            border-bottom: 1px solid #ddd;
        }

        tr:nth-child(even) {
            background: #fff3dc;
        }

        tr:hover {
            background: #ffe9bd;
        }


        /* COMBOS */

        .combo-grid {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 20px;
        }

        .combo {
            background: white;
            padding: 25px;
            border-radius: 10px;
            border: 1px solid #e3d9ca;
        }

        .combo h3 {
            color: #b90f2f;
        }

        .combo strong {
            font-size: 20px;
            color: #b90f2f;
        }


        /* ORDER */

        .order-section {
            background: #f7e7c4;
        }

        form {
            background: white;
            max-width: 950px;
            margin: auto;
            padding: 35px;
            border-radius: 12px;
            border: 1px solid #ddd;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        }

        fieldset {
            border: 1px solid #d7c8b4;
            margin-bottom: 25px;
            padding: 22px;
            border-radius: 7px;
        }

        legend {
            color: #b90f2f;
            font-weight: bold;
            padding: 0 8px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-top: 14px;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 11px;
            margin-top: 6px;
            border: 1px solid #bbb;
            border-radius: 4px;
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: 2px solid #f5c542;
            border-color: #b90f2f;
        }

        textarea {
            min-height: 100px;
            resize: vertical;
        }

        .form-grid {
            display: grid;
            grid-template-columns:
                1fr 1fr;
            gap: 18px;
        }

        .radio-group,
        .check-group {
            margin-top: 10px;
        }

        .radio-group label,
        .check-group label {
            display: inline-block;
            font-weight: normal;
            margin-right: 18px;
        }

        .radio-group input,
        .check-group input {
            width: auto;
            margin-right: 5px;
        }

        .delivery-note {
            background: #fff7e6;
            border-left: 5px solid #f5c542;
            padding: 15px;
            margin-bottom: 20px;
        }

        .submit-area {
            text-align: center;
        }

        .submit-button {
            background: #b90f2f;
            color: white;
            border: none;
            padding: 15px 35px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
        }

        .submit-button:hover {
            background: #8e0923;
        }


        /* CONTACT */

        .contact-grid {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 20px;
        }

        .contact-box {
            background: white;
            padding: 25px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .contact-box h3 {
            color: #b90f2f;
        }


        /* FOOTER */

        footer {
            background: #292929;
            color: white;
            padding: 35px 7%;
        }

        .footer-inner {
            max-width: 1200px;
            margin: auto;

            display: grid;
            grid-template-columns:
                2fr 1fr 1fr;

            gap: 30px;
        }

        footer h3 {
            margin-top: 0;
            color: #f5c542;
        }

        footer a {
            color: white;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        .copyright {
            border-top: 1px solid #555;
            margin-top: 25px;
            padding-top: 20px;
            text-align: center;
            font-size: 13px;
            color: #ccc;
        }


        /* RESPONSIVE */

        @media (max-width: 900px) {

            .header-inner {
                flex-direction: column;
            }

            .hero-inner {
                grid-template-columns: 1fr;
            }

            .hero-text h2 {
                font-size: 42px;
            }

            .why-grid,
            .category-grid,
            .best-grid,
            .promo-grid,
            .combo-grid {
                grid-template-columns: 1fr 1fr;
            }

            .footer-inner {
                grid-template-columns: 1fr 1fr;
            }

        }


        @media (max-width: 600px) {

            header {
                padding: 20px;
            }

            nav {
                display: block;
                text-align: center;
            }

            nav a {
                display: inline-block;
                margin: 2px;
            }

            .hero {
                padding: 45px 20px;
            }

            .section {
                padding: 45px 20px;
            }

            .hero-text h2 {
                font-size: 36px;
            }

            .hero-image img {
                height: 280px;
            }

            .why-grid,
            .category-grid,
            .best-grid,
            .promo-grid,
            .combo-grid,
            .contact-grid,
            .footer-inner {
                grid-template-columns: 1fr;
            }

            form {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


